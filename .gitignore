bin/
obj/
.vs/
.idea/
*.user
*.suo
TestResults/
artifacts/
publish/

# Local settings and secrets must never be committed.
.env
.env.*
appsettings.Local.json
*.secrets.json

# La única credencial del asistente es OPENROUTER_API_KEY y vive en el entorno del usuario,
# nunca en un archivo. Estas reglas cubren los lugares donde alguien podría dejarla sin querer.
*.key
*.pem
credenciales*.json
servidores-mcp.json
mcp-*.json

# La de Google SÍ vive en un archivo, porque el usuario lo pidió así: abrir, pegar y guardar es más
# simple que aprender setx. Ese archivo vive fuera del repositorio —en la carpeta de datos— y esta
# línea es el segundo cerrojo, para el día en que alguien lo copie acá para depurar algo.
claves.json

# Estado local del asistente: es del equipo donde corre, no del repositorio.
# Además delata al usuario (transcripciones, agenda, gasto) y pesa cientos de megas.
aprendido.json
reglas.json
objetivos.json
usage-ledger.json
assistant-data.json
settings.json
window.json
memory.json

# Estos tres se sumaron después y delatan tanto como los de arriba: las misiones llevan lo que el
# usuario pidió y con qué palabras, los permisos llevan a quién le confía qué, y la bitácora lleva
# el recorrido de una sesión entera.
misiones.json
autonomia.json
trace.log

# Modelos de Whisper: 466 MB que se bajan en la instalación, no se versionan.
*.bin
*.ggml

# Herramientas y cachés
.claude/
*.lock
node_modules/
