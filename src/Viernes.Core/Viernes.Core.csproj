<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Cliente MCP oficial de C#, mantenido junto con Microsoft. Es lo que convierte a Viernes de
      «hace las diez cosas que alguien le programó» a «hace lo que traiga cada servidor que le
      conectes». No aporta modelo: el modelo sigue siendo el de OpenRouter, y MCP sólo entrega
      definiciones de herramientas y ejecuta las llamadas.
      Se usa .Core y no el paquete completo porque acá sólo hace falta el lado cliente.
    -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      La memoria personal sigue siendo una biblioteca aparte que no sabe nada de conversaciones ni
      de herramientas: la referencia apunta de acá hacia allá y nunca al revés. Hace falta porque
      lo que se destila al cerrar una charla no tenía ninguna forma de aprobarse, y aprobar es un
      pedido que llega hablando —o sea, una herramienta— y las herramientas viven acá.
    -->
    <ProjectReference Include="..\Viernes.Memory\Viernes.Memory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      La carpeta donde vive el archivo de claves se resuelve con GetFolderPath, que consulta a
      Windows y NO mira la variable LOCALAPPDATA: no hay forma de redirigirla desde afuera. Sin esta
      costura, una prueba de escritura de claves o escribe en el archivo real de quien compila, o
      se saltea sola. Se saltearon ocho, en verde, sin que nadie se enterara.
    -->
    <InternalsVisibleTo Include="Viernes.Core.Tests" />
  </ItemGroup>

</Project>
