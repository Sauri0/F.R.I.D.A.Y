<Window x:Class="Viernes.App.Shell.AssistantNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cómo me llamo"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#0C1014"
        Foreground="#E8EDF2"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8EDF2"/>
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8695A2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="CÓMO ME LLAMO" Style="{StaticResource Etiqueta}"/>
        <TextBlock FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#B9C4CE"
                   Text="El nombre es también la palabra con la que me llamás en voz alta. Cambia enseguida: no hace falta reiniciar."/>

        <Border Background="#141A20" CornerRadius="10" Padding="4" Margin="0,14,0,0">
            <TextBox x:Name="Nombre" Background="Transparent" Foreground="#E8EDF2"
                     BorderThickness="0" CaretBrush="#4FBEC6" FontSize="20" Padding="12,10"
                     MaxLength="24" TextChanged="Nombre_TextChanged"/>
        </Border>

        <!-- Una sola línea para las dos cosas: cómo va a quedar, o por qué no se puede. -->
        <TextBlock x:Name="VistaPrevia" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"
                   MinHeight="34" Foreground="#8695A2"/>

        <TextBlock x:Name="Aviso" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"
                   Foreground="#E0AE52" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="BotonCancelar" Content="Cancelar" Padding="18,9" Margin="0,0,10,0"
                    IsCancel="True" Click="Cancelar_Click"/>
            <Button x:Name="BotonAceptar" Content="Aceptar" Padding="18,9"
                    IsDefault="True" Click="Aceptar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
