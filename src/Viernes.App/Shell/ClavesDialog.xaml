<Window x:Class="Viernes.App.Shell.ClavesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mis claves"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#0C1014"
        Foreground="#E8EDF2"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8EDF2"/>
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8695A2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="Ayuda" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8695A2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Campo" TargetType="Border">
            <Setter Property="Background" Value="#141A20"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="MIS CLAVES" Style="{StaticResource Etiqueta}"/>
        <TextBlock FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#B9C4CE"
                   Text="Pegá una clave para ponerla o cambiarla. Lo que ya está guardado no se muestra nunca, ni acá ni en ningún registro."/>

        <!-- OpenRouter -->
        <TextBlock Text="OPENROUTER · PARA PENSAR" Style="{StaticResource Etiqueta}" Margin="0,20,0,0"/>
        <TextBlock x:Name="EstadoRouter" FontSize="12.5" Margin="0,4,0,0" Foreground="#7FC8A9"/>
        <Border Style="{StaticResource Campo}" Margin="0,8,0,0">
            <PasswordBox x:Name="ClaveRouter" Background="Transparent" Foreground="#E8EDF2"
                         BorderThickness="0" CaretBrush="#4FBEC6" FontSize="15" Padding="12,10"
                         PasswordChanged="Campo_Cambio"/>
        </Border>
        <TextBlock Style="{StaticResource Ayuda}" Margin="0,6,0,0"
                   Text="Empieza con «sk-or-». Se guarda en las variables de entorno de tu cuenta de Windows, no en un archivo. Sacala gratis en openrouter.ai/keys"/>

        <!-- Google -->
        <TextBlock Text="GOOGLE · PARA HABLAR EN VIVO (OPCIONAL)" Style="{StaticResource Etiqueta}" Margin="0,22,0,0"/>
        <TextBlock x:Name="EstadoGoogle" FontSize="12.5" Margin="0,4,0,0" Foreground="#7FC8A9"/>
        <Border Style="{StaticResource Campo}" Margin="0,8,0,0">
            <PasswordBox x:Name="ClaveGoogle" Background="Transparent" Foreground="#E8EDF2"
                         BorderThickness="0" CaretBrush="#4FBEC6" FontSize="15" Padding="12,10"
                         PasswordChanged="Campo_Cambio"/>
        </Border>
        <TextBlock Style="{StaticResource Ayuda}" Margin="0,6,0,0"
                   Text="Con ella me escuchás contestar mientras pienso y me podés cortar hablándome encima. Sin ella ando igual, por el camino de siempre. Sacala en aistudio.google.com/apikey"/>

        <TextBlock x:Name="Aviso" FontSize="12.5" Margin="0,16,0,0" TextWrapping="Wrap"
                   Foreground="#E0AE52" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button x:Name="BotonBorrarRouter" Content="Borrar la de OpenRouter" Padding="12,8"
                    Margin="0,0,8,0" Click="BorrarRouter_Click"/>
            <Button x:Name="BotonBorrarGoogle" Content="Borrar la de Google" Padding="12,8"
                    Click="BorrarGoogle_Click"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BotonCancelar" Content="Cancelar" Padding="18,9" Margin="0,0,10,0"
                    IsCancel="True" Click="Cancelar_Click"/>
            <Button x:Name="BotonGuardar" Content="Guardar" Padding="18,9"
                    IsDefault="True" IsEnabled="False" Click="Guardar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
