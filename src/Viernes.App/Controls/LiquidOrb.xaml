<UserControl x:Class="Viernes.App.Controls.LiquidOrb"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal"
             Width="108"
             Height="108"
             Background="Transparent"
             IsHitTestVisible="False"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!--
        Todo se dibuja en un espacio de 70 unidades y el Viewbox lo escala. La silueta la calcula el
        code-behind cuadro a cuadro: son ocho puntos sobre una elipse, cada uno con su propio período,
        unidos con tangentes Catmull-Rom. No hay Storyboard sobre la geometría porque la excursión y
        la viscosidad cambian con el estado, y un Storyboard fijo no puede seguir eso.
    -->
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="Stage" Width="70" Height="70" Background="Transparent">

            <!-- La masa. El glow es su propio DropShadowEffect, teñido del color de estado. -->
            <Path x:Name="Mass">
                <Path.Fill>
                    <RadialGradientBrush x:Name="MassFill"
                                         GradientOrigin="0.38,0.29"
                                         Center="0.44,0.40"
                                         RadiusX="0.80"
                                         RadiusY="0.80">
                        <GradientStop x:Name="StopLight" Color="#FFB9ECFF" Offset="0" />
                        <GradientStop x:Name="StopBody" Color="#FF72D9FF" Offset="0.50" />
                        <GradientStop x:Name="StopDeep" Color="#FF17607F" Offset="0.84" />
                        <GradientStop x:Name="StopRim" Color="#FF08314A" Offset="1" />
                    </RadialGradientBrush>
                </Path.Fill>
                <Path.Effect>
                    <DropShadowEffect x:Name="MassGlow"
                                      Color="#FF72D9FF"
                                      BlurRadius="18"
                                      ShadowDepth="0"
                                      Opacity="0.30" />
                </Path.Effect>
            </Path>

            <!--
                Los reflejos van recortados por la silueta y fuera de cualquier transform de la masa:
                la luz es del ambiente, no del objeto. Al deformarse el cuerpo, el recorte hace que
                la luz resbale sobre el borde en vez de despegarse.
            -->
            <Canvas x:Name="Reflections" Width="70" Height="70">

                <!-- Rebote: luz que atraviesa y se concentra contra el borde opuesto. -->
                <Ellipse x:Name="Bounce"
                         Canvas.Left="39.75"
                         Canvas.Top="45.10"
                         Width="9.5"
                         Height="6.8">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="BounceCore" Color="#5772D9FF" Offset="0" />
                            <GradientStop x:Name="BounceEdge" Color="#0072D9FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Luz difusa: confirma la curvatura sin parecer una pastilla pegada. -->
                <Ellipse Canvas.Left="44.60"
                         Canvas.Top="24.25"
                         Width="4.8"
                         Height="3.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#2EFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Especular: chico y muy brillante. Es lo que separa mojado de mancha de color. -->
                <Ellipse Canvas.Left="23.90"
                         Canvas.Top="23.55"
                         Width="5.0"
                         Height="3.3"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-24" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#EBFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
