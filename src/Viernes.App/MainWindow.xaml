<Window x:Class="Viernes.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="clr-namespace:Viernes.App.Shell"
        xmlns:controls="clr-namespace:Viernes.App.Controls"
        mc:Ignorable="d"
        Title="Viernes"
        Icon="Assets/Viernes.ico"
        d:Width="528"
        d:Height="272"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AutomationProperties.Name="Viernes, asistente de escritorio"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        PreviewMouseMove="Orb_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Orb_PreviewMouseLeftButtonUp"
        LostMouseCapture="Orb_LostMouseCapture"
        ShowActivated="False">

    <!--
        La ventana no cambia de tamaño nunca: mide el desplegable más ancho, el más alto y el aire de
        las sombras, y es transparente. Lo que se anima es el vidrio de adentro. Cambiar Width y
        Height de la ventana por cuadro es lo que hacía saltar al orbe, porque estando anclado a una
        esquina había que corregir Left y Top a mano en el mismo cuadro.
    -->

    <Window.Resources>
        <shell:PanelKindVisibilityConverter x:Key="PanelIs" />
        <shell:StateBrushConverter x:Key="StateBrush" />
        <shell:StateColorConverter x:Key="StateColor" />
        <shell:EmptyToVisibilityConverter x:Key="WhenEmpty" />
        <shell:FilledToVisibilityConverter x:Key="WhenFilled" />
        <shell:DictationOpacityConverter x:Key="DictadoAlfa" />
        <shell:DictationStyleConverter x:Key="DictadoEstilo" />

        <!--
            Jerarquía tipográfica dentro de 140 px de alto útil. Una sola línea primaria por panel:
            si hay dos cosas importantes, una está de más. Los datos van en Consolas porque montos,
            identificadores y horas se leen con precisión y se repiten en voz alta.
        -->
        <Style x:Key="Primaria" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#FFF4F4F7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Secundaria" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="#FFCACAD1" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Encabezado" TargetType="TextBlock" BasedOn="{StaticResource Primaria}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="Dato" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FFEAEAEE" />
        </Style>

        <Style x:Key="Pie" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="#FF9C9CA4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Un botón, o dos. Lo irreversible nunca es un botón: es un mantener apretado. -->
        <Style x:Key="BotonTenue" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="#FFCACAD1" />
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Superficie"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#24FFFFFF"
                                BorderThickness="1"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Superficie" Property="Background" Value="#20FFFFFF" />
                                <Setter Property="Foreground" Value="#FFEFEFF3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Superficie" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonAmbar" TargetType="Button" BasedOn="{StaticResource BotonTenue}">
            <Setter Property="Foreground" Value="#FF17150F" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Superficie" CornerRadius="13" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFC46B" Offset="0" />
                                    <GradientStop Color="#FFF5A331" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Superficie" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Superficie" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Lo que no existe todavía se dice, no se inventa con datos plausibles. -->
        <Style x:Key="Vacio" TargetType="TextBlock" BasedOn="{StaticResource Secundaria}">
            <Setter Property="Foreground" Value="#FF8C8C95" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            Los tres niveles de un permiso, uno al lado del otro. Son tres botones y no un control que
            va rotando: rotando, para llegar a «nunca» hay que pasar por «lo hace sola», y ése es
            exactamente el estado por el que no se quiere pasar ni un instante.
        -->
        <Style x:Key="Segmento" TargetType="Button" BasedOn="{StaticResource BotonTenue}">
            <Setter Property="Height" Value="21" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="8.5" />
            <Setter Property="Margin" Value="3,0,0,0" />
        </Style>

        <!-- Una fila de lista: la línea de abajo del separador y nada más. -->
        <Style x:Key="Separador" TargetType="Border">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#0DFFFFFF" />
        </Style>

        <!-- La columna angosta de la izquierda: un identificador, una rama, un estado. -->
        <Style x:Key="Guia" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#FF72D9FF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--
            El menú del botón derecho sobre el orbe. Es la única puerta que tienen los desplegables
            que el usuario abre a mano: sin esto, nueve de los diecinueve son código que nadie llama.

            Va con plantilla propia y no con la del sistema porque el menú del sistema es claro, con
            esquinas vivas y su propia tipografía: al lado de un orbe de vidrio se lee como si lo
            hubiera abierto otro programa.
        -->
        <Style x:Key="MenuDelOrbe" TargetType="ContextMenu">
            <Setter Property="Background" Value="#F21A1A1E" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF000000" BlurRadius="32" Direction="270" ShadowDepth="8" Opacity="0.55" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ItemDelMenu" TargetType="MenuItem">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#FFEAEAEE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Fondo" Background="Transparent" Padding="15,6" MinWidth="190">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            El item que además dice en cuál estás. Es su propio estilo y no un IsCheckable sobre el
            de arriba porque aquella plantilla no tiene dónde poner la marca: el ContentPresenter
            ocupa el ancho entero, así que un IsChecked ahí no se vería y la opción obligaría a
            probarla para saber cómo estaba puesta. Los items sin marca siguen usando el otro y no
            se corren: la columna de la marca sólo existe acá.
        -->
        <Style x:Key="ItemTildadoDelMenu" TargetType="MenuItem" BasedOn="{StaticResource ItemDelMenu}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Fondo" Background="Transparent" Padding="15,6" MinWidth="190">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="17" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Tilde"
                                           Text="✓"
                                           Opacity="0"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tilde" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RayaDelMenu" TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="13,5" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- La columna angosta de la derecha: casi siempre desde cuándo. -->
        <Style x:Key="Cola" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="#FF9C9CA4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Canvas x:Name="Stage" Background="{x:Null}">

        <!-- ============================ EL VIDRIO ============================ -->
        <Grid x:Name="PanelHost"
              Canvas.Top="26"
              Width="376"
              Height="220"
              Background="{x:Null}"
              Visibility="Collapsed"
              MouseEnter="Panel_MouseEnter"
              MouseLeave="Panel_MouseLeave">

            <shell:GlassSurface x:Name="Glass"
                                Width="372"
                                Height="206"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0,0.5"
                                Tint="{Binding State, Converter={StaticResource StateColor}}"
                                LifeProgress="{Binding PanelLifeProgress}">
                <shell:GlassSurface.RenderTransform>
                    <ScaleTransform x:Name="GlassScale" ScaleX="1" ScaleY="1" />
                </shell:GlassSurface.RenderTransform>
                <shell:GlassSurface.Effect>
                    <DropShadowEffect Color="#FF000000" BlurRadius="56" Direction="270" ShadowDepth="16" Opacity="0.62" />
                </shell:GlassSurface.Effect>

                <Grid>
                    <!--
                        El barrido: lo único que se mueve en el vidrio, y por eso funciona. Va como
                        hijo y no dibujado en el panel porque mover un TranslateTransform lo compone
                        la GPU: repintar ocho capas para correr un reflejo no vale la pena.
                    -->
                    <Rectangle x:Name="Sweep"
                               Width="130"
                               HorizontalAlignment="Left"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#1AFFFFFF" Offset="0.48" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="SweepOffset" X="-160" />
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <Grid x:Name="PanelContent" Margin="16,14,16,13">

                        <!-- ===== 1 · escribir · 372 × 206 · escuchando · neutro · no se cierra sola ===== -->
                        <Grid Visibility="{Binding ActivePanel, Converter={StaticResource PanelIs}, ConverterParameter=Escribir}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource Primaria}"
                                               Text="{Binding MessageText}"
                                               MaxHeight="34"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Secundaria}"
                                               Margin="0,5,0,0"
                                               Text="Podés seguir escribiendo en la otra ventana: no te robo el teclado hasta que hagas clic acá." />
                                </StackPanel>
                                <!--
                                    Silenciar y guardarse son las dos únicas cosas que hay que poder
                                    hacer sin hablar ni escribir, así que viven en el panel de
                                    conversación y no en una barra permanente.
                                -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource CompactCircleButton}"
                                            Command="{Binding ToggleMuteCommand}"
                                            Content="{Binding MuteGlyph}"
                                            ToolTip="{Binding MuteToolTip}"
                                            AutomationProperties.Name="{Binding MuteToolTip}" />
                                    <Button Style="{StaticResource CompactCircleButton}"
                                            Margin="4,0,0,0"
                                            Click="HideButton_Click"
                                            Content="&#xE921;"
                                            ToolTip="Guardarse en la bandeja"
                                            AutomationProperties.Name="Guardarse en la bandeja" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2"
                                    Height="34"
                                    CornerRadius="11"
                                    Background="#8C0B0B0D"
                                    BorderBrush="#26FFFFFF"
                                    BorderThickness="1"
                                    Padding="11,0,4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="Escribí una instrucción…"
                                                   Foreground="#FFA2A2AA"
                                                   FontFamily="{StaticResource UiFont}"
                                                   FontSize="11"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding InputText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox x:Name="PromptTextBox"
                                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{StaticResource TextPrimary}"
                                                 CaretBrush="{StaticResource Cyan}"
                                                 FontFamily="{StaticResource UiFont}"
                                                 FontSize="11"
                                                 SpellCheck.IsEnabled="True"
                                                 KeyDown="PromptTextBox_KeyDown"
                                                 AutomationProperties.Name="Instrucción escrita" />
                                    </Grid>
                                    <Button Grid.Column="1"
                                            Command="{Binding SendCommand}"
                                            Content="Enviar"
                                            Height="26"
                                            Padding="13,0"
                                            Foreground="#FF0E1416"
                                            FontFamily="{StaticResource UiFont}"
                                            FontSize="9"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Enviar" CornerRadius="13" Padding="{TemplateBinding Padding}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FF8AE1FF" Offset="0" />
                                                            <GradientStop Color="#FF5FCDF6" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Enviar" Property="Opacity" Value="0.35" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="3" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Pie}" Text="Enter envía · Esc cierra" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource Pie}"
                                           FontFamily="Consolas"
                                           Text="{Binding ModeLabel}" />
                            </Grid>
                        </Grid>

                        <!-- ===== 2 · trabajando · 364 × 200 · pensando · neutro · no se cierra sola ===== -->
                        <Grid Visibility="{Binding ActivePanel, Converter={StaticResource PanelIs}, ConverterParameter=Trabajando}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0"
                                         Width="10"
                                         Height="10"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding State, Converter={StaticResource StateBrush}}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Encabezado}" Text="Trabajando" />
                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource Pie}"
                                           FontFamily="Consolas"
                                           Text="{Binding StatusText}"
                                           MaxWidth="150" />
                            </Grid>

                            <ItemsControl Grid.Row="1"
                                          Margin="0,9,0,0"
                                          ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0"
                                                     Width="5"
                                                     Height="5"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#FF2E4055" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="Fill" Value="#FF72F0C0" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                                <Setter Property="Fill" Value="#FFFFB347" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Fill" Value="#FF9BB7FF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Label}"
                                                       ToolTip="{Binding Label}"
                                                       FontFamily="{StaticResource UiFont}"
                                                       FontSize="11"
                                                       LineHeight="15"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FF62758A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF9DB0C2" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFC56B" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- No promete un porcentaje: sólo dice que algo se mueve. -->
                            <Border Grid.Row="2" Height="2" Margin="0,0,0,9" CornerRadius="1" Background="#12FFFFFF">
                                <Border x:Name="TurnPulse"
                                        Width="90"
                                        HorizontalAlignment="Left"
                                        CornerRadius="1"
                                        Background="#FF9BB7FF"
                                        Opacity="0.7">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="TurnPulseOffset" X="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource Pie}"
                                           VerticalAlignment="Center"
                                           Text="Nada se ejecuta sin figurar acá" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource BotonTenue}"
                                        Command="{Binding CancelTurnCommand}"
                                        Content="Cancelar" />
                            </Grid>
                        </Grid>

                        <!-- ===== 3 · calendario · 364 × 188 · reposo · neutro · 7 s ===== -->
                        <Grid Visibility="{Binding ActivePanel, Converter={StaticResource PanelIs}, ConverterParameter=Calendario}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource Encabezado}" Text="Tu agenda" />
                            <ItemsControl Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding ListItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="32">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="74" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
