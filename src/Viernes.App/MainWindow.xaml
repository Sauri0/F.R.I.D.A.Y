                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Style="{StaticResource Separador}" />
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock FontFamily="{StaticResource UiFont}"
                                                           FontSize="11.5"
                                                           Foreground="#FFEAEAEE"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Text}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontFamily="{StaticResource UiFont}"
                                                           FontSize="9.5"
                                                           Foreground="#FF9C9CA4"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding With}"
                                                           ToolTip="{Binding Why}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0"
                                                        Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Command="{Binding SetAutomaticCommand}"
                                                        Content="sola"
                                                        AutomationProperties.Name="Que lo haga sola">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource Segmento}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAutomatic}" Value="True">
                                                                    <Setter Property="Background" Value="#3872D9FF" />
                                                                    <Setter Property="Foreground" Value="#FFEAF7FF" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Command="{Binding SetAskCommand}"
                                                        Content="preguntá"
                                                        AutomationProperties.Name="Que pregunte antes">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource Segmento}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAsk}" Value="True">
                                                                    <Setter Property="Background" Value="#38FFB347" />
                                                                    <Setter Property="Foreground" Value="#FFFFE3B4" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Command="{Binding SetNeverCommand}"
                                                        Content="nunca"
                                                        AutomationProperties.Name="Que no lo haga nunca">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource Segmento}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNever}" Value="True">
                                                                    <Setter Property="Background" Value="#38FF7385" />
                                                                    <Setter Property="Foreground" Value="#FFFFD5DB" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource Vacio}"
                                       Visibility="{Binding Board.Permissions.Count, Converter={StaticResource WhenEmpty}}"
                                       Text="{Binding Board.PermissionsNote}" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Pie}" Text="{Binding Board.Outcome}" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource Pie}"
                                           Margin="8,0,0,0"
                                           Text="{Binding Board.More}" />
                            </Grid>
                        </Grid>

                        <!-- ===== 18 · lo que aprendí · 364 × 200 · reposo · neutro · no se cierra solo ===== -->
                        <Grid Visibility="{Binding ActivePanel, Converter={StaticResource PanelIs}, ConverterParameter=Aprendido}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Encabezado}" Text="Lo que aprendí de vos" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource IconButton}"
                                        Width="22"
                                        Height="22"
                                        Command="{Binding ClosePanelCommand}"
                                        Content="&#xE711;"
                                        ToolTip="Cerrar" />
                            </Grid>
                            <ItemsControl Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Board.Memory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="42">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Style="{StaticResource Separador}" />
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock FontFamily="{StaticResource UiFont}"
                                                           FontSize="11.5"
                                                           Foreground="#FFEAEAEE"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Content}"
                                                           ToolTip="{Binding Content}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <!-- El identificador va acá porque es lo que hace falta para «/olvidar». -->
                                                    <TextBlock Style="{StaticResource Guia}"
                                                               FontSize="9"
                                                               Foreground="#FF6E7C86"
                                                               Text="{Binding ShortId}" />
                                                    <TextBlock Style="{StaticResource Cola}"
                                                               Margin="7,0,0,0"
                                                               Foreground="#FFFFB347"
                                                               Text="{Binding Trail}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0"
                                                        Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <!--
                                                    Aprobar es lo único que convierte una suposición en
                                                    un hecho, y siempre empieza acá. Sin esto, Viernes
                                                    aprendía todas las noches y se olvidaba todas las
                                                    noches: la observación vencía sola a los siete días.
                                                -->
                                                <Button Style="{StaticResource Segmento}"
                                                        Command="{Binding ApproveCommand}"
                                                        Content="es cierto"
                                                        Visibility="{Binding IsPending, Converter={StaticResource BoolVisibility}}"
                                                        AutomationProperties.Name="Confirmar que es cierto" />
                                                <Button Style="{StaticResource Segmento}"
                                                        Command="{Binding RejectCommand}"
                                                        Content="no"
                                                        Visibility="{Binding IsPending, Converter={StaticResource BoolVisibility}}"
                                                        AutomationProperties.Name="Descartarlo" />
                                                <Button Style="{StaticResource Segmento}"
                                                        Command="{Binding ForgetCommand}"
                                                        Content="olvidalo"
                                                        Visibility="{Binding IsKnown, Converter={StaticResource BoolVisibility}}"
                                                        AutomationProperties.Name="Olvidar este dato" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource Vacio}"
                                       Visibility="{Binding Board.Memory.Count, Converter={StaticResource WhenEmpty}}"
                                       Text="{Binding Board.MemoryNote}" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Pie}" Text="{Binding Board.Outcome}" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource Pie}"
                                           Margin="8,0,0,0"
                                           Text="{Binding Board.More}" />
                            </Grid>
                        </Grid>

                        <!-- ===== 19 · gasto · 364 × 166 · reposo · neutro · 7 s ===== -->
                        <Grid Visibility="{Binding ActivePanel, Converter={StaticResource PanelIs}, ConverterParameter=Consumo}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource Encabezado}" Text="Cuánto llevo gastado" />
                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource Dato}"
                                               FontSize="16"
                                               Foreground="#FF72D9FF"
                                               Text="{Binding Board.Spend.TodayText}" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource Secundaria}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Bottom"
                                               Text="hoy" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource Cola}"
                                               VerticalAlignment="Bottom"
                                               Text="{Binding Board.Spend.DailyBudgetText}" />
                                </Grid>

                                <!-- Sin tope no hay barra: una barra vacía se lee como «no gastaste nada». -->
                                <Border Height="4"
                                        Margin="0,8,0,0"
                                        CornerRadius="2"
                                        Background="#1FFFFFFF"
                                        HorizontalAlignment="Left"
                                        Width="332"
                                        Visibility="{Binding Board.Spend.HasDailyBudget, Converter={StaticResource BoolVisibility}}">
                                    <Border HorizontalAlignment="Left"
                                            CornerRadius="2"
                                            Background="#FF72D9FF"
                                            Width="{Binding Board.Spend.BarWidth}" />
                                </Border>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource Dato}"
                                               Text="{Binding Board.Spend.MonthText}" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource Secundaria}"
                                               FontSize="10.5"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="este mes" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource Cola}"
                                               Text="{Binding Board.Spend.MonthlyBudgetText}" />
                                </Grid>

                                <TextBlock Style="{StaticResource Pie}"
                                           Margin="0,7,0,0"
                                           FontFamily="Consolas"
                                           Text="{Binding Board.Spend.TrafficText}" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Style="{StaticResource Pie}" Text="{Binding Board.SpendNote}" />
                        </Grid>
                    </Grid>
                </Grid>
            </shell:GlassSurface>
        </Grid>

        <!-- ============================ EL ORBE ============================ -->
        <Grid x:Name="OrbDragSurface"
              Width="108"
              Height="108"
              Background="Transparent"
              PreviewMouseLeftButtonDown="Orb_PreviewMouseLeftButtonDown"
              ToolTip="Tocar: escribir · arrastrar: mover · decí «Viernes» para hablar">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="OrbPresenceScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="OrbPresenceOffset" X="0" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Grid x:Name="OrbHost" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="OrbArrivalScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="OrbArrivalOffset" X="0" Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>
            </Grid>

            <Button x:Name="OrbButton"
                    Width="76"
                    Height="76"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Background="Transparent"
                    Cursor="Hand"
                    Focusable="True"
                    Click="OrbButton_Click"
                    AutomationProperties.Name="Viernes: tocar para escribir, arrastrar para mover">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PressDepth" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Touch" Fill="Transparent" />
                            <Ellipse x:Name="Wet" Margin="2" Fill="#00FFFFFF" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Wet" Property="Fill" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Wet" Property="Fill" Value="#22000000" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressDepth"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.9" Duration="0:0:0.11" />
                                            <DoubleAnimation Storyboard.TargetName="PressDepth"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.9" Duration="0:0:0.11" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressDepth"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PressDepth"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ================= PÍLDORA DE ESTADO Y BURBUJA DE DICTADO ================= -->
        <Grid x:Name="OrbOverlay" Width="108" Height="108" IsHitTestVisible="False">

            <!--
                La píldora. Centrada sobre el orbe y 36 px por encima de su borde superior, que es
                donde la pone el boceto (left:54px, top:-36px sobre un orbe de 108). Morfea de ancho
                en vez de aparecer y desaparecer, y por eso es un control y no un Border con un
                binding: el ancho se dibuja adentro para no pedir layout una vez por cuadro
                encima de un orbe que ya está dibujando. Sus cuatro propiedades se enganchan en el
                código de la ventana, junto con las de los dos cuerpos.

                El Margin NO está acá: lo pone MeasurePillSlack() al construir la ventana, midiendo
                la píldora. Este contenedor mide lo que mide el orbe —108— y la etiqueta más larga
                mide más; sin ensanchar la celda WPF le pone un clip de layout y la corta. Estuvo
                escrito a mano como -110 a cada lado, que es un número probado hasta que dejó de
                verse el corte: aguanta hasta que alguien agregue un estado de nombre más largo, y
                ahí vuelve a fallar en silencio.
            -->
            <controls:StatePill x:Name="Pill"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top" />

            <!--
                La burbuja de dictado. Nace pegada al orbe —la esquina chica apunta a él— y crece hacia
                el lado libre. Está lista para recibir parciales; hoy el reconocedor entrega la frase
                entera al soltar el micrófono.
            -->
            <Border x:Name="DictationBubble"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="2,0,0,116"
                    Width="312"
                    Padding="15,13,15,12"
                    CornerRadius="20,20,20,7"
                    Background="#8C18181C"
                    BorderBrush="#30FFFFFF"
                    BorderThickness="1"
                    Visibility="{Binding IsDictationVisible, Converter={StaticResource BoolVisibility}}">
                <Border.Effect>
                    <DropShadowEffect Color="#FF000000" BlurRadius="42" Direction="270" ShadowDepth="12" Opacity="0.6" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6"
                                 Height="6"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding State, Converter={StaticResource StateBrush}}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   FontSize="9.5"
                                   Foreground="#FFAFAFB7"
                                   Text="te escucho" />
                        <Border Width="60"
                                Height="3"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                CornerRadius="2"
                                Background="#1FFFFFFF">
                            <Border x:Name="DictationLevel"
                                    HorizontalAlignment="Left"
                                    Width="0"
                                    CornerRadius="2"
                                    Background="{Binding State, Converter={StaticResource StateBrush}}" />
                        </Border>
                    </StackPanel>
                    <!--
                        El encabezado del tramo recuperado. Aparece sólo cuando hay algo que recuperar,
                        que es cuando dijiste el nombre en el medio de una frase: sin él, lo que dijiste
                        ANTES de nombrarla se lee igual que lo que le dijiste a ella, y eso se siente
                        como espiar aunque el asistente esté haciendo exactamente lo que le pediste.
                    -->
                    <TextBlock Margin="0,7,0,0"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="10.5"
                               Foreground="#FFF4F4F7"
                               Opacity="0.40"
                               Text="{Binding RecoveredDictationLabel}"
                               Visibility="{Binding HasRecoveredDictation, Converter={StaticResource BoolVisibility}}" />

                    <!--
                        Una palabra por celda y no un solo TextBlock: las tres calidades se deciden por
                        palabra —lo recuperado al 40 %, lo confirmado pleno, y la última en itálica al
                        60 % mientras se está formando— y eso no se puede pintar con un Text= suelto.
                        El WrapPanel las acomoda como texto corrido.
                    -->
                    <ItemsControl Margin="0,4,0,0"
                                  MaxHeight="52"
                                  ItemsSource="{Binding DictationWords}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,4,0"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="12.5"
                                           LineHeight="17"
                                           Foreground="#FFF4F4F7"
                                           Text="{Binding Text}"
                                           Opacity="{Binding Quality, Converter={StaticResource DictadoAlfa}}"
                                           FontStyle="{Binding Quality, Converter={StaticResource DictadoEstilo}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Canvas>
</Window>
