<Window x:Class="Viernes.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Viernes"
        Width="{Binding WidgetWidth, FallbackValue=90}"
        Height="{Binding WidgetHeight, FallbackValue=90}"
        MinWidth="84"
        MinHeight="84"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AutomationProperties.Name="Viernes, asistente de escritorio"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <Grid x:Name="ShellGrid" Margin="4" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeadingColumn" Width="80" />
            <ColumnDefinition x:Name="TrailingColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <!-- El aura es también la zona de arrastre. El núcleo interior conserva PTT. -->
        <Grid x:Name="OrbDragSurface"
              Grid.Column="0"
              Width="80"
              Height="80"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Background="Transparent"
              MouseLeftButtonDown="DragSurface_MouseLeftButtonDown"
              ToolTip="Tocar: escribir · arrastrar desde el aura: mover · decí «Viernes» para hablar">
            <!--
                La gota. Sin anillos: el fluido mismo dice en qué estado está. Se inserta desde
                código para evitar la compilación en dos pasadas que WPF dispara cuando el XAML
                referencia un tipo del propio ensamblado.
            -->
            <Grid x:Name="OrbHost" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="OrbArrivalScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="OrbArrivalOffset" X="0" Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>
            </Grid>

            <Border Panel.ZIndex="7"
                    Margin="0,-2,0,0"
                    Padding="6,2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    CornerRadius="7"
                    Background="#E60B1116"
                    BorderBrush="#36FFFFFF"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    Visibility="{Binding IsStateLabelVisible, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding StateShortLabel}"
                           Foreground="#FFE9F4F8"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="8.5"
                           FontWeight="SemiBold" />
            </Border>

            <Button x:Name="OrbButton"
                    Width="60"
                    Height="60"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Background="Transparent"
                    Cursor="Hand"
                    Focusable="True"
                    Click="OrbButton_Click"
                    AutomationProperties.Name="Viernes: tocar para escribir">
                <!--
                    El botón ya no dibuja: es sólo la superficie de contacto sobre la gota. Al
                    presionar hunde el fluido, que es lo que hace un líquido cuando lo tocás.
                -->
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PressDepth" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Touch" Fill="Transparent" />
                            <Ellipse x:Name="Wet"
                                     Margin="2"
                                     Fill="#00FFFFFF"
                                     IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Wet" Property="Fill" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Wet" Property="Fill" Value="#22000000" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressDepth"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.9" Duration="0:0:0.11" />
                                            <DoubleAnimation Storyboard.TargetName="PressDepth"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.9" Duration="0:0:0.11" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressDepth"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="2" Springiness="5" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PressDepth"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="2" Springiness="5" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </Grid>

        <!-- La burbuja aparece sólo durante interacción o cuando el usuario abre texto. -->
        <Border x:Name="AssistantBubble"
                Grid.Column="1"
                Margin="-1,2,2,2"
                Padding="14,10,8,8"
                VerticalAlignment="Stretch"
                CornerRadius="5,24,24,5"
                BorderThickness="1"
                BorderBrush="#4072D9FF"
                Visibility="{Binding IsAssistantShellVisible, Converter={StaticResource BoolVisibility}}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F31A242E" Offset="0" />
                    <GradientStop Color="#F5202832" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#B0000000" BlurRadius="18" Direction="270" ShadowDepth="5" Opacity="0.55" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="0,0,5,2"
                           Text="{Binding MessageText}"
                           ToolTip="{Binding MessageText}"
                           Foreground="{StaticResource TextPrimary}"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="12.5"
                           FontWeight="Medium"
                           LineHeight="17"
                           MaxHeight="36"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding IsMessageVisible, Converter={StaticResource BoolVisibility}}" />

                <!--
                    Listas de agenda, recordatorios o memoria. La burbuja crece a 168 px sólo mientras
                    las muestra: sigue siendo temporal, nunca un panel fijo.
                -->
                <ItemsControl Grid.Row="0"
                              Margin="0,0,5,2"
                              ItemsSource="{Binding ListItems}"
                              Visibility="{Binding AreListItemsVisible, Converter={StaticResource BoolVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="62" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Margin="0,0,8,0"
                                           Text="{Binding When}"
                                           Foreground="{StaticResource Cyan}"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding What}"
                                           ToolTip="{Binding What}"
                                           Foreground="#FFE3EBF2"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="11.5"
                                           LineHeight="15"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Margin="8,0,0,0"
                                           Text="{Binding Tag}"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="Consolas"
                                           FontSize="9"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    Pasos del turno. Reemplazan al mensaje mientras trabaja para que la espera muestre
                    qué está haciendo, y sobre todo si una herramienta quedó bloqueada por la política.
                -->
                <ItemsControl Grid.Row="0"
                              Margin="0,0,5,2"
                              ItemsSource="{Binding Steps}"
                              Visibility="{Binding AreStepsVisible, Converter={StaticResource BoolVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="13" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0"
                                         Width="5"
                                         Height="5"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#FF2E4055" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="Fill" Value="#FF72F0C0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                    <Setter Property="Fill" Value="#FFFFB347" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Fill" Value="#FF9BB7FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Label}"
                                           ToolTip="{Binding Label}"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="11"
                                           LineHeight="15"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FF62758A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF9DB0C2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFC56B" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Margin="0,0,4,0"
                               VerticalAlignment="Center"
                               Text="{Binding StatusText}"
                               ToolTip="{Binding StatusText}"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="9.5"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource CompactCircleButton}"
                                Width="26" Height="26"
                                Command="{Binding ToggleMuteCommand}"
                                Content="{Binding MuteGlyph}"
                                ToolTip="{Binding MuteToolTip}"
                                AutomationProperties.Name="{Binding MuteToolTip}" />
                        <Button Style="{StaticResource CompactCircleButton}"
                                Width="26" Height="26"
                                Command="{Binding ToggleExpandedCommand}"
                                Content="&#xE70D;"
                                ToolTip="Escribir"
                                AutomationProperties.Name="Abrir entrada de texto" />
                        <Button Style="{StaticResource CompactCircleButton}"
                                Width="26" Height="26"
                                Click="HideButton_Click"
                                Content="&#xE921;"
                                ToolTip="Ocultar en la bandeja"
                                AutomationProperties.Name="Ocultar en la bandeja" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Height="34"
                        Margin="0,5,0,0"
                        Padding="10,0,4,0"
                        CornerRadius="11"
                        Background="#76101820"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1"
                        Visibility="{Binding IsInputAreaVisible, Converter={StaticResource BoolVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBlock VerticalAlignment="Center"
                                       Text="Escribí una instrucción…"
                                       Foreground="#FF718293"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="10.5"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InputText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="PromptTextBox"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}"
                                     CaretBrush="{StaticResource Cyan}"
                                     FontFamily="{StaticResource UiFont}"
                                     FontSize="11"
                                     SpellCheck.IsEnabled="True"
                                     KeyDown="PromptTextBox_KeyDown"
                                     AutomationProperties.Name="Instrucción escrita" />
                        </Grid>
                        <Button Grid.Column="1"
                                Width="26" Height="26"
                                Command="{Binding SendCommand}"
                                Content="&#xE122;"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="10"
                                Foreground="#FF14202A"
                                Background="{StaticResource Cyan}"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Enviar">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SendSurface" Background="{TemplateBinding Background}" CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="SendSurface" Property="Opacity" Value="0.35" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Height="34"
                        Margin="0,5,0,0"
                        Padding="9,0,4,0"
                        CornerRadius="11"
                        Background="#45FFC56B"
                        BorderBrush="#88FFC56B"
                        BorderThickness="1"
                        ToolTip="{Binding ConfirmationDetail}"
                        Visibility="{Binding IsConfirmationAreaVisible, Converter={StaticResource BoolVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="67" />
                            <ColumnDefinition Width="27" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding ConfirmationTitle}"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1"
                                Height="24"
                                Margin="2,0"
                                Command="{Binding ConfirmCommand}"
                                Content="Confirmar"
                                Foreground="#FF1A202A"
                                Background="{StaticResource Amber}"
                                BorderThickness="0"
                                FontFamily="{StaticResource UiFont}"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                Width="26" Height="26"
                                Command="{Binding DismissConfirmationCommand}"
                                Content="&#xE711;"
                                ToolTip="Cancelar" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
